# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. See DEPLOYMENT.md for the full guide.

# --- Postgres (used by the postgres container AND the api-server container) ---
POSTGRES_USER=zaboni
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=zaboni
# Built automatically from the three vars above inside docker-compose.yml;
# only override DATABASE_URL directly if you are pointing at an external DB
# instead of the bundled postgres container.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Core secrets (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Long random string used as the bearer token for /api/admin/* routes
ADMIN_SECRET=

# --- Object storage (local-disk backend for VPS deployments) ---
STORAGE_MODE=local
LOCAL_STORAGE_PUBLIC_DIR=/data/storage/public
LOCAL_STORAGE_PRIVATE_DIR=/data/storage/private

# --- Web push (VAPID) ---
# Generate with: pnpx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@zaboni.com

# --- Native push: Firebase Cloud Messaging (Android) ---
# From the Firebase service-account JSON. Optional — FCM auto-disables if unset.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Native push: Apple Push Notification service (iOS) ---
# Optional — APNs auto-disables if unset.
APN_KEY=
APN_KEY_ID=
APPLE_TEAM_ID=
APN_BUNDLE_ID=com.zaboni.delivery

# --- Optional integrations ---
# WaVerify (WhatsApp OTP) — omit to keep the app in SMS/dev-code fallback mode
WAVERIFY_API_KEY=
# Slack/webhook alert URL for admin monitoring
ADMIN_ALERT_WEBHOOK_URL=
# Phone number allow-listed for Apple App Store review (bypasses OTP)
APPLE_REVIEW_PHONE=

NODE_ENV=production

# Only needed if the GitHub repository is private: fine-grained token for this
# repo with read-only Contents access, used to mirror the direct-download APK.
APK_GITHUB_TOKEN=

# Nightly backups to Cloudflare R2 (start with: docker compose --profile backup up -d)
# R2 → Manage R2 API tokens → Object Read & Write for the backup bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zaboni-backups
# Encrypts every backup. Store a copy OUTSIDE the server — without it the
# backups cannot be restored.
BACKUP_PASSPHRASE=
