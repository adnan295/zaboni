{
  "name": "workspace",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:sync-from-prod": "pnpm --filter @workspace/scripts run db:sync-from-prod"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "devDependencies": {
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "proxy-addr@2": "2.0.8",
      "body-parser@2": "2.4.0",
      "engine.io@6": "6.6.11",
      "socket.io-parser@4": "4.2.7",
      "undici@7": "7.30.1",
      "axios@1": "1.21.0",
      "follow-redirects@1": "1.16.2",
      "ip-address@10": "10.7.5",
      "fast-xml-parser@5": "5.11.2",
      "@fastify/busboy@3": "3.2.4",
      "@grpc/grpc-js@1": "1.14.7"
    }
  }
}
