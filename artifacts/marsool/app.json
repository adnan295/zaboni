{
  "expo": {
    "name": "زبوني",
    "slug": "zaboni",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zaboni",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "زبوني — خدمة توصيل سريعة وموثوقة في حمص. اطلب من أي مطعم وتابع طلبك لحظة بلحظة.",
    "primaryLanguage": "ar",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DC2626"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#DC2626",
      "androidMode": "default"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaboni.delivery",
      "buildNumber": "17",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "CFBundleDisplayName": "زبوني",
        "CFBundleLocalizations": [
          "ar",
          "en",
          "ar",
          "en"
        ],
        "CFBundleDevelopmentRegion": "ar",
        "NSUserNotificationsUsageDescription": "يرسل زبوني إشعارات لتحديثات الطلبات والعروض الخاصة",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zaboni.delivery",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#DC2626"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withRoomFix",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-updates",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#DC2626",
          "defaultChannel": "default",
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج زبوني إلى موقعك لتحديد موقع التوصيل والمندوب القريب",
          "locationWhenInUsePermission": "يحتاج زبوني إلى موقعك لتحديد موقع التوصيل والمندوب القريب",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaboni uses your photo library to update your profile picture. You can select any photo from your album to display on your account.",
          "cameraPermission": "يستخدم زبوني الكاميرا لالتقاط صورة ملفك الشخصي مباشرة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/7632bc54-6c31-4b8a-ae83-b3b0076bce20",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.4",
    "extra": {
      "eas": {
        "projectId": "1c6933f5-b854-465f-8bc3-4abf5b6be78f"
      }
    },
    "owner": "adnanalshawa"
  }
}
